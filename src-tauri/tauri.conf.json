{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zux",
  "version": "0.1.0",
  "identifier": "com.github.hrzlgnm.zux",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "rpm",
      "msi",
      "nsis",
      "dmg"
    ],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "changelog": "../CHANGELOG.md",
        "files": {
          "/usr/share/man/man1/zux.1": "../docs/zux.1"
        }
      },
      "rpm": {
        "compression": {
          "type": "xz",
          "level": 6
        },
        "files": {
          "/usr/share/doc/zux/changelog": "../CHANGELOG.md",
          "/usr/share/man/man1/zux.1": "../docs/zux.1"
        }
      }
    },
    "windows": {
      "certificateThumbprint": "4f3cc75f545c898d57c5cc4349873a3bff8d4527",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hrzlgnm/zux/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4MjE2MUNDMjBCODY4QjkKUldTNWFMZ2d6R0VocU5DUEZSVGdzejFmVm81ZUcrMHB0SHdySmlNbWUwTEcyVHdWdlRsdjBLQ2MK"
    }
  }
}
