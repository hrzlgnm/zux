{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:event:default",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "store:default",
    "core:window:allow-set-theme",
    "core:window:allow-theme",
    "core:app:allow-set-app-theme"
  ]
}
